<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.terminal.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/terminal/venv/bin/python</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>server:app</string>
        <string>--host</string><string>127.0.0.1</string>
        <string>--port</string><string>8002</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>__HOME__</string>
        <key>PATH</key><string>__BREW_BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Everything the terminal can reach. Narrow this to a work directory
             if you do not want your whole home readable. -->
        <key>TERMINAL_ROOT</key><string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key><string>__HOME__/terminal</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>__HOME__/terminal/logs/terminal.log</string>
    <key>StandardErrorPath</key><string>__HOME__/terminal/logs/terminal.log</string>
</dict>
</plist>
