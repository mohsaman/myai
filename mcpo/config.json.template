{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "__HOME__/ai-workspace"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": { "MEMORY_FILE_PATH": "__HOME__/mcpo/memory.json" }
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=__TZ__"]
    }
  }
}
