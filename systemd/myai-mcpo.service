[Unit]
Description=mcpo — MCP tool servers exposed as OpenAPI for Open WebUI
After=network.target

[Service]
Type=simple
WorkingDirectory=__HOME__/mcpo
ExecStart=__HOME__/mcpo/venv/bin/mcpo \
  --host 127.0.0.1 --port 8001 \
  --api-key __MCPO_APIKEY__ \
  --cors-allow-origins http://127.0.0.1:8080 \
  --config __HOME__/mcpo/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
