diff --git a/packages/app/src/composer/next-step.test.ts b/packages/app/src/composer/next-step.test.ts
new file mode 100644
index 0000000..288d7db
--- /dev/null
+++ b/packages/app/src/composer/next-step.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, test } from "bun:test"
+import { cleanNextStep } from "./next-step"
+
+describe("Composer next-step suggestion", () => {
+  test("keeps a plain one-line suggestion", () => {
+    expect(cleanNextStep("Run the tests for the parser")).toBe("Run the tests for the parser")
+  })
+
+  test("takes the first non-empty line and strips surrounding quotes", () => {
+    expect(cleanNextStep('\n  "Add a test for --dry-run"\nbecause it is untested')).toBe("Add a test for --dry-run")
+  })
+
+  test("drops a reasoning block", () => {
+    expect(cleanNextStep("<think>maybe tests</think>\nCommit the change")).toBe("Commit the change")
+  })
+
+  test("treats NONE, empty and missing text as no suggestion", () => {
+    expect(cleanNextStep("NONE")).toBeUndefined()
+    expect(cleanNextStep("none.")).toBeUndefined()
+    expect(cleanNextStep("   ")).toBeUndefined()
+    expect(cleanNextStep(undefined)).toBeUndefined()
+  })
+
+  test("rejects an overlong line rather than truncating it", () => {
+    expect(cleanNextStep("x".repeat(161))).toBeUndefined()
+  })
+})
diff --git a/packages/app/src/composer/next-step.ts b/packages/app/src/composer/next-step.ts
new file mode 100644
index 0000000..44c71f1
--- /dev/null
+++ b/packages/app/src/composer/next-step.ts
@@ -0,0 +1,107 @@
+import { createSignal, onCleanup, type Accessor } from "solid-js"
+import type { Data } from "@opencode/client/solid"
+import type { ComposerAdapter } from "./adapter"
+
+// Suggested next step: after a run in this session succeeds, ask the session's
+// model for the single most useful next message, and offer it as ghost text in
+// the empty composer. Tab accepts it into the draft; typing replaces it.
+//
+// The suggestion comes from session.generate -- the one-shot call the TUI /btw
+// command uses -- which answers from the session's context without adding
+// anything to the conversation.
+
+// session.generate exposes the session's tools but runs no tool loop, so the
+// instructions rule tool calls out. They ask for a suggestion every time: an
+// opt-out ("reply NONE if nothing follows") is taken by small models even when a
+// useful follow-up exists. NONE is still honoured if it appears.
+const INSTRUCTIONS = [
+  "Propose the user's single most useful NEXT message in this conversation --",
+  "a follow-up question, a check, or the obvious next task. Always propose one.",
+  "Reply with ONLY that message, exactly as the user would type it: specific to",
+  "what just happened, under 15 words. No quotes, no preamble, no explanation.",
+  "Do not call any tools and do not take any actions.",
+].join(" ")
+
+const MAX_CHARS = 160
+
+export function cleanNextStep(raw: string | undefined) {
+  const line = (raw ?? "")
+    .replace(/<think>[\s\S]*?<\/think>/g, "")
+    .split("\n")
+    .map((item) => item.trim())
+    .find(Boolean)
+    ?.replace(/^["'`“”]+|["'`“”]+$/g, "")
+    .trim()
+  if (!line || /^none\.?$/i.test(line) || line.length > MAX_CHARS) return undefined
+  return line
+}
+
+// Opt-in trace for diagnosing: localStorage.setItem("opencode.nextStep.debug", "1")
+function trace(message: string) {
+  try {
+    if (globalThis.localStorage?.getItem("opencode.nextStep.debug") === "1") console.info(`[next-step] ${message}`)
+  } catch {}
+}
+
+export type ComposerNextStep = {
+  // The suggestion to show, only while the draft is empty and nothing is running.
+  text: Accessor<string | undefined>
+  // Moves the suggestion into the draft. False when there is nothing to accept.
+  accept: () => boolean
+}
+
+export function createComposerNextStep(input: {
+  adapter: ComposerAdapter
+  blank: Accessor<boolean>
+  data: Pick<Data, "on" | "session">
+}): ComposerNextStep {
+  const adapter = input.adapter
+  const [suggestion, setSuggestion] = createSignal<string>()
+  if (adapter.kind !== "active-session") return { text: () => undefined, accept: () => false }
+
+  // Driven by the server's lifecycle events for this session -- the same events
+  // the notifications use -- rather than by the working flag: a run's outcome is
+  // only settled when execution.succeeded arrives. Every start bumps the epoch,
+  // so a generation that returns after the next run began is dropped.
+  let epoch = 0
+  const sessionID = () => adapter.session().id
+
+  const started = input.data.on("session.execution.started", (event) => {
+    if (event.data.sessionID !== sessionID()) return
+    epoch++
+    setSuggestion(undefined)
+  })
+  const succeeded = input.data.on("session.execution.succeeded", (event) => {
+    const id = event.data.sessionID
+    if (id !== sessionID()) return
+    if (input.data.session.get(id)?.parentID !== undefined) return trace(`${id} skipped: subagent`)
+    const mine = ++epoch
+    const begun = Date.now()
+    trace(`${id} run succeeded; generating`)
+    void adapter
+      .session()
+      .api.generate({ sessionID: id, prompt: INSTRUCTIONS })
+      .then((result) => {
+        if (mine !== epoch) return trace(`${id} dropped: superseded`)
+        const text = cleanNextStep(result?.text)
+        trace(`${id} generated in ${Date.now() - begun} ms: ${JSON.stringify(result?.text)} -> ${JSON.stringify(text)}`)
+        if (text) setSuggestion(text)
+      })
+      .catch((cause: unknown) => trace(`${id} generate failed: ${String(cause)}`))
+  })
+  onCleanup(() => {
+    started()
+    succeeded()
+  })
+
+  return {
+    text: () => (input.blank() && !adapter.working() ? suggestion() : undefined),
+    accept: () => {
+      const text = suggestion()
+      if (!text || !input.blank()) return false
+      adapter.state.set([{ type: "text", content: text, start: 0, end: text.length }], text.length)
+      setSuggestion(undefined)
+      return true
+    },
+  }
+}
