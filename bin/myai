#!/usr/bin/env bash
# myai — start/stop a local AI stack (Ollama + ComfyUI + Kokoro + Open WebUI)
#
#   myai start        start everything, wait until ready, open the browser
#   myai stop         stop everything (stays stopped across reboots)
#   myai restart      stop then start
#   myai status       show what is running
#   myai logs [comfy|kokoro|tts|jupyter|mcpo|terminal]
#   myai backup [dir] archive chats/users/config
#
# Works on macOS (launchd) and Linux (systemd user units).
#
# Reboot behaviour: 'start' enables the services so they return at login;
# 'stop' disables them, so they stay down until 'myai start' is issued again.

set -uo pipefail

# ---------------------------------------------------------------- platform ---
case "$(uname -s)" in
  Darwin) OS=mac   ;;
  Linux)  OS=linux ;;
  *) echo "unsupported platform: $(uname -s)"; exit 1 ;;
esac

WEBUI_PORT=8080
WEBUI_URL="http://127.0.0.1:${WEBUI_PORT}"
OLLAMA_URL="http://127.0.0.1:11434"
COMFY_URL="http://127.0.0.1:8188"
KOKORO_URL="http://127.0.0.1:8880"
TTS_URL="http://127.0.0.1:8881"
JUPYTER_URL="http://127.0.0.1:8888"
MCPO_URL="http://127.0.0.1:8001"
TERMINAL_URL="http://127.0.0.1:8002"
OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-60s}"
# Context window. The KV cache for this must fit in GPU memory beside the weights
# or inference silently spills to the CPU. 32768 keeps a 30B MoE at ~19.5 GB on a
# 32 GB machine; 65536 pushes it to 21 GB, which swaps once a browser is open.
OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-32768}"
OLLAMA_FLASH_ATTENTION="${OLLAMA_FLASH_ATTENTION:-1}"
OLLAMA_KV_CACHE_TYPE="${OLLAMA_KV_CACHE_TYPE:-q8_0}"
READY_TIMEOUT=120
STOP_TIMEOUT=30

LOG_DIR="$HOME/.open-webui/logs"
COMFY_LOG_DIR="$HOME/ComfyUI/logs"
KOKORO_LOG_DIR="$HOME/kokoro/logs"
TTS_LOG_DIR="$HOME/piper/logs"
JUPYTER_LOG_DIR="$HOME/jupyter/logs"
MCPO_LOG_DIR="$HOME/mcpo/logs"
TERMINAL_LOG_DIR="$HOME/terminal/logs"

if [ "$OS" = mac ]; then
  GUI="gui/$(id -u)"
  AGENTS="$HOME/Library/LaunchAgents"
  SVC_OLLAMA="ollama"                       # managed via brew services
  SVC_COMFY="com.comfyui.server"
  SVC_KOKORO="com.kokoro.server"
  SVC_TTS="com.ttsrouter.server"
  SVC_WEBUI="com.openwebui.server"
  SVC_JUPYTER="com.jupyter.server"
  SVC_MCPO="com.mcpo.server"
  SVC_TERMINAL="com.terminal.server"
  OPENER="open"
else
  SVC_OLLAMA="myai-ollama"                  # all four are systemd user units
  SVC_COMFY="myai-comfyui"
  SVC_KOKORO="myai-kokoro"
  SVC_TTS="myai-tts-router"
  SVC_WEBUI="myai-openwebui"
  SVC_JUPYTER="myai-jupyter"
  SVC_MCPO="myai-mcpo"
  SVC_TERMINAL="myai-terminal"
  OPENER="xdg-open"
fi

BOLD=$'\033[1m'; GREEN=$'\033[32m'; RED=$'\033[31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$1"; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$OFF" "$1"; }
info() { printf '  %s•%s %s\n' "$DIM" "$OFF" "$1"; }

up_ollama() { curl -fsS --max-time 2 "$OLLAMA_URL/api/version"    >/dev/null 2>&1; }
up_webui()  { curl -fsS --max-time 2 "$WEBUI_URL/health"          >/dev/null 2>&1; }
up_comfy()  { curl -fsS --max-time 2 "$COMFY_URL/system_stats"    >/dev/null 2>&1; }
up_kokoro() { curl -fsS --max-time 2 "$KOKORO_URL/v1/audio/voices">/dev/null 2>&1; }
up_tts()    { curl -fsS --max-time 2 "$TTS_URL/health">/dev/null 2>&1; }
# /api is the one Jupyter route that answers without the auth token.
up_jupyter(){ curl -fsS --max-time 2 "$JUPYTER_URL/api"              >/dev/null 2>&1; }
up_mcpo()   { curl -fsS --max-time 2 "$MCPO_URL/openapi.json"        >/dev/null 2>&1; }
up_terminal(){ curl -fsS --max-time 2 "$TERMINAL_URL/health"          >/dev/null 2>&1; }

# ------------------------------------------------- service control per OS ---
svc_installed() {  # svc_installed <service>
  if [ "$OS" = mac ]; then
    [ "$1" = "$SVC_OLLAMA" ] && { command -v brew >/dev/null 2>&1; return; }
    [ -f "$AGENTS/$1.plist" ]
  else
    systemctl --user cat "$1.service" >/dev/null 2>&1
  fi
}

svc_up() {  # svc_up <service>  — enable persistently, then start
  if [ "$OS" = mac ]; then
    if [ "$1" = "$SVC_OLLAMA" ]; then
      # 'brew services start' regenerates its own plist from the formula's
      # template every time, discarding anything added to the copy in
      # ~/Library/LaunchAgents. launchctl setenv is what actually survives —
      # and it survives 'brew upgrade ollama' too.
      for v in OLLAMA_KEEP_ALIVE OLLAMA_CONTEXT_LENGTH OLLAMA_FLASH_ATTENTION OLLAMA_KV_CACHE_TYPE; do
        launchctl setenv "$v" "${!v}" 2>/dev/null   # ${!v} = value of the named var
      done
      brew services start ollama >/dev/null 2>&1
    else
      launchctl enable "$GUI/$1" 2>/dev/null
      launchctl bootstrap "$GUI" "$AGENTS/$1.plist" 2>/dev/null
    fi
  else
    systemctl --user enable "$1.service" >/dev/null 2>&1
    systemctl --user start  "$1.service" >/dev/null 2>&1
  fi
}

svc_down() {  # svc_down <service>  — stop, and keep it down across reboots
  if [ "$OS" = mac ]; then
    if [ "$1" = "$SVC_OLLAMA" ]; then
      brew services stop ollama >/dev/null 2>&1
    else
      launchctl bootout  "$GUI/$1" 2>/dev/null
      launchctl disable  "$GUI/$1" 2>/dev/null
    fi
  else
    systemctl --user stop    "$1.service" >/dev/null 2>&1
    systemctl --user disable "$1.service" >/dev/null 2>&1
  fi
}

lan_ip() {
  if [ "$OS" = mac ]; then
    ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true
  else
    hostname -I 2>/dev/null | awk '{print $1}'
  fi
}

# ------------------------------------------------------------------ waits ---
wait_for() {  # wait_for <name> <up-fn>
  local name="$1" fn="$2" waited=0
  printf '  %s…%s waiting for %s' "$DIM" "$OFF" "$name"
  while ! "$fn"; do
    if [ "$waited" -ge "$READY_TIMEOUT" ]; then
      printf '\r'; bad "$name did not come up within ${READY_TIMEOUT}s"; return 1
    fi
    sleep 2; waited=$((waited+2)); printf '.'
  done
  printf '\r%*s\r' 70 ''
  ok "$name ready"
}

# Shutdown is not instant: the supervisor returns before the process exits.
wait_down() {  # wait_down <name> <up-fn>
  local name="$1" fn="$2" waited=0
  while "$fn"; do
    if [ "$waited" -ge "$STOP_TIMEOUT" ]; then
      bad "$name still responding after ${STOP_TIMEOUT}s"; return 1
    fi
    sleep 1; waited=$((waited+1))
  done
  ok "$name stopped"
}

# --------------------------------------------------------------- residue ----
# Ollama forks a separate runner per loaded model; ComfyUI/PyTorch can leave
# workers behind. Patterns are narrow so shells merely mentioning these paths
# (e.g. a download into ~/ComfyUI) are never matched.
residue_pids() {
  pgrep -f 'bin/ollama|ollama runner|ollama_llama_server|llama-server|open[-_]webui|ComfyUI/main\.py|api\.src\.main:app|jupyter_server|mcpo/venv/bin/mcpo|uvicorn server:app' 2>/dev/null \
    | grep -vx "$$" | grep -vx "$PPID" | while read -r p; do
        case "$(ps -o command= -p "$p" 2>/dev/null)" in *myai*) ;; *) echo "$p" ;; esac
      done
}

sweep_residue() {
  local pids; pids=$(residue_pids)
  [ -z "$pids" ] && { ok "no residual processes"; return 0; }
  info "clearing residual processes:"
  for p in $pids; do
    printf '      %s %s\n' "$p" "$(ps -o comm= -p "$p" 2>/dev/null | sed 's|.*/||')"
    kill "$p" 2>/dev/null
  done
  local waited=0
  while [ -n "$(residue_pids)" ] && [ "$waited" -lt 10 ]; do sleep 1; waited=$((waited+1)); done
  for p in $(residue_pids); do printf '      %s did not exit — forcing\n' "$p"; kill -9 "$p" 2>/dev/null; done
  [ -z "$(residue_pids)" ] && ok "residual processes cleared" || bad "still running: $(residue_pids | tr '\n' ' ')"
}

# ------------------------------------------------------------- commands -----
cmd_start() {
  printf '%sStarting local AI stack%s  %s(%s)%s\n' "$BOLD" "$OFF" "$DIM" "$OS" "$OFF"

  if svc_installed "$SVC_OLLAMA"; then
    if up_ollama; then ok "Ollama already running"
    else svc_up "$SVC_OLLAMA"; wait_for "Ollama" up_ollama || return 1; fi
  else
    bad "Ollama not installed"; return 1
  fi

  for pair in "$SVC_COMFY|ComfyUI|up_comfy" "$SVC_KOKORO|Kokoro TTS|up_kokoro" \
              "$SVC_TTS|TTS router|up_tts" \
              "$SVC_JUPYTER|Jupyter|up_jupyter" "$SVC_MCPO|MCP tools|up_mcpo" \
              "$SVC_TERMINAL|Terminal|up_terminal"; do
    IFS='|' read -r svc name fn <<<"$pair"
    svc_installed "$svc" || continue
    if "$fn"; then ok "$name already running"
    else svc_up "$svc"; wait_for "$name" "$fn" || info "$name did not start — myai logs"; fi
  done

  if svc_installed "$SVC_WEBUI"; then
    if up_webui; then ok "Open WebUI already running"
    else svc_up "$SVC_WEBUI"; wait_for "Open WebUI" up_webui || { info "check: myai logs"; return 1; }; fi
  fi

  local models; models=$(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}' | paste -sd', ' -)
  [ -n "$models" ] && info "models: $models" || info "no models yet — ollama pull <model>"
  printf '  %s→%s %s\n' "$BOLD" "$OFF" "$WEBUI_URL"
  if [ -z "${MYAI_NO_OPEN:-}" ]; then
    "$OPENER" "$WEBUI_URL" >/dev/null 2>&1 || info "open $WEBUI_URL in your browser"
  fi
}

cmd_stop() {
  printf '%sStopping local AI stack%s\n' "$BOLD" "$OFF"
  svc_installed "$SVC_WEBUI"  && { svc_down "$SVC_WEBUI";  wait_down "Open WebUI" up_webui; }
  svc_installed "$SVC_COMFY"  && { svc_down "$SVC_COMFY";  wait_down "ComfyUI"    up_comfy; }
  svc_installed "$SVC_TTS" && { svc_down "$SVC_TTS"; wait_down "TTS router" up_tts; }
  svc_installed "$SVC_KOKORO" && { svc_down "$SVC_KOKORO"; wait_down "Kokoro TTS" up_kokoro; }
  svc_installed "$SVC_TERMINAL" && { svc_down "$SVC_TERMINAL"; wait_down "Terminal"  up_terminal; }
  svc_installed "$SVC_MCPO"    && { svc_down "$SVC_MCPO";    wait_down "MCP tools"  up_mcpo; }
  svc_installed "$SVC_JUPYTER" && { svc_down "$SVC_JUPYTER"; wait_down "Jupyter"    up_jupyter; }
  svc_installed "$SVC_OLLAMA" && { svc_down "$SVC_OLLAMA"; wait_down "Ollama"     up_ollama; }

  sweep_residue

  local ports; ports=$(lsof -nP -iTCP:8080 -iTCP:11434 -iTCP:8188 -iTCP:8880 -iTCP:8881 -iTCP:8888 -iTCP:8001 -iTCP:8002 -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ')
  [ -n "$ports" ] && bad "ports still bound by pid(s): $ports" || ok "ports 8080/11434/8188/8880/8881/8888/8001/8002 released"
  info "stays stopped across reboots until: myai start"
}

cmd_status() {
  printf '%sLocal AI stack%s  %s(%s)%s\n' "$BOLD" "$OFF" "$DIM" "$OS" "$OFF"
  up_ollama && ok "Ollama     $OLLAMA_URL" || bad "Ollama     not running"
  if svc_installed "$SVC_COMFY";  then up_comfy  && ok "ComfyUI    $COMFY_URL  (loopback only)"  || bad "ComfyUI    not running"; fi
  if svc_installed "$SVC_KOKORO"; then up_kokoro && ok "Kokoro TTS $KOKORO_URL  (loopback only)" || bad "Kokoro TTS not running"; fi
  if svc_installed "$SVC_TTS"; then up_tts && ok "TTS router $TTS_URL  (loopback only)" || bad "TTS router not running"; fi
  if svc_installed "$SVC_JUPYTER"; then up_jupyter && ok "Jupyter    $JUPYTER_URL  (code interpreter)" || bad "Jupyter    not running"; fi
  if svc_installed "$SVC_TERMINAL"; then
    up_terminal && ok "Terminal   $TERMINAL_URL  (read-only shell)" || bad "Terminal   not running"
  fi
  if svc_installed "$SVC_MCPO"; then
    if up_mcpo; then
      local n; n=$(curl -fsS --max-time 3 "$MCPO_URL/openapi.json" 2>/dev/null \
        | tr ',' '\n' | grep -c '"/[a-z]' || true)
      ok "MCP tools  $MCPO_URL  (filesystem, fetch, memory, time)"
    else bad "MCP tools  not running"; fi
  fi
  if up_webui; then
    ok "Open WebUI $WEBUI_URL"
    local ip; ip=$(lan_ip); [ -n "$ip" ] && info "LAN: http://${ip}:${WEBUI_PORT}"
  else bad "Open WebUI not running"; fi

  printf '\n  %sservices%s\n' "$DIM" "$OFF"
  if [ "$OS" = mac ]; then
    launchctl list 2>/dev/null | grep -E 'openwebui|ollama|comfyui|kokoro|ttsrouter|jupyter|mcpo|terminal' | sed 's/^/    /' || echo "    (none loaded)"
  else
    systemctl --user list-units --type=service --no-legend 'myai-*' 2>/dev/null | sed 's/^/    /' || echo "    (none loaded)"
  fi

  local models; models=$(ollama list 2>/dev/null | tail -n +2)
  [ -n "$models" ] && { printf '\n  %smodels%s\n' "$DIM" "$OFF"; echo "$models" | sed 's/^/    /'; }
}

cmd_logs() {
  case "${1:-}" in
    comfy)  d="$COMFY_LOG_DIR";  u="$SVC_COMFY"  ;;
    kokoro) d="$KOKORO_LOG_DIR"; u="$SVC_KOKORO" ;;
    tts)    d="$TTS_LOG_DIR";    u="$SVC_TTS" ;;
    jupyter) d="$JUPYTER_LOG_DIR"; u="$SVC_JUPYTER" ;;
    mcp|mcpo) d="$MCPO_LOG_DIR";   u="$SVC_MCPO"   ;;
    term|terminal) d="$TERMINAL_LOG_DIR"; u="$SVC_TERMINAL" ;;
    *)      d="$LOG_DIR";        u="$SVC_WEBUI"  ;;
  esac
  if [ "$OS" = linux ]; then
    info "journalctl --user -u $u -f"
    journalctl --user -u "$u" -n 50 -f
  else
    [ -d "$d" ] || { bad "no log directory at $d"; return 1; }
    info "tailing $d (ctrl-c to exit)"
    tail -n 50 -f "$d/stdout.log" "$d/stderr.log" 2>/dev/null
  fi
}

cmd_backup() {
  local dest="${1:-$HOME/myai-backups}" stamp out was_up=0
  stamp=$(date +%Y%m%dT%H%M%S); out="$dest/myai-$stamp.tar.gz"
  mkdir -p "$dest" || { bad "cannot create $dest"; return 1; }

  printf '%sBacking up local AI stack%s\n' "$BOLD" "$OFF"
  info "chats/users/RAG live in SQLite — stopping Open WebUI for a consistent copy"
  if up_webui; then was_up=1; svc_down "$SVC_WEBUI"; wait_down "Open WebUI" up_webui; fi

  local extra=()
  [ "$OS" = mac ] && extra=(-C "$HOME/Library/LaunchAgents" com.openwebui.server.plist com.comfyui.server.plist com.kokoro.server.plist com.ttsrouter.server.plist com.jupyter.server.plist com.mcpo.server.plist com.terminal.server.plist)
  [ "$OS" = linux ] && [ -d "$HOME/.config/systemd/user" ] && extra=(-C "$HOME/.config/systemd/user" .)

  # --exclude MUST precede the paths it applies to. bsdtar (the macOS default)
  # silently ignores excludes that come after, which is how a 20 MB backup of
  # chats and uploads became a 1.2 GB copy of the venv and the Whisper cache.
  # GNU tar accepts either order, so this only shows up on a Mac.
  tar -czf "$out" \
      --exclude='.open-webui/venv' --exclude='.open-webui/cache' --exclude='.open-webui/logs' \
      -C "$HOME" .open-webui \
      "${extra[@]}" 2>/dev/null

  [ -f "$out" ] && ok "backup: $out ($(du -h "$out" | cut -f1))" || bad "backup failed"

  local old; old=$(ls -1t "$dest"/myai-*.tar.gz 2>/dev/null | tail -n +8)
  [ -n "$old" ] && { echo "$old" | xargs rm -f; info "pruned $(echo "$old" | wc -l | tr -d ' ') old backup(s)"; }

  [ "$was_up" = 1 ] && { svc_up "$SVC_WEBUI"; wait_for "Open WebUI" up_webui; }
  info "models are NOT backed up (re-pull with: ollama pull <name>)"
}



# --------------------------------------------------------------- terminal ---
# Named SSH targets the terminal server may reach. The model picks a NAME from
# this file and never supplies an address, so it cannot direct a connection.
TERMINAL_HOSTS="$HOME/terminal/hosts.json"

cmd_terminal() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  mkdir -p "$(dirname "$TERMINAL_HOSTS")"

  case "$sub" in
    list)
      printf '%sTerminal targets%s\n' "$BOLD" "$OFF"
      ok "local    this machine"
      HOSTS="$TERMINAL_HOSTS" python3 <<'PYLIST'
import json, os
try:
    hosts = json.load(open(os.environ["HOSTS"]))
except Exception:
    hosts = {}
hosts = {k: v for k, v in hosts.items() if not k.startswith("_") and isinstance(v, dict)}
if not hosts:
    print("  \033[2m•\033[0m no remote hosts — myai terminal add <name> <user@host>")
for name, h in sorted(hosts.items()):
    dest = f"{h['user']}@{h['host']}" if h.get("user") else h.get("host", "?")
    bits = [dest]
    if h.get("port"): bits.append(f"port {h['port']}")
    if h.get("jump"): bits.append(f"via {h['jump']}")
    print(f"  \033[32m✓\033[0m {name:<8} {' · '.join(bits)}")
PYLIST
      ;;
    add)
      local name="${1:-}" dest="${2:-}"; shift 2 2>/dev/null || true
      if [ -z "$name" ] || [ -z "$dest" ]; then
        bad "usage: myai terminal add <name> <[user@]host> [--port N] [--key PATH] [--jump host]"; return 1
      fi
      local port='' key='' jump=''
      while [ $# -gt 0 ]; do
        case "$1" in
          --port) port="$2"; shift 2 ;;
          --key)  key="$2";  shift 2 ;;
          --jump) jump="$2"; shift 2 ;;
          *) bad "unknown option: $1"; return 1 ;;
        esac
      done
      HOSTS="$TERMINAL_HOSTS" NAME="$name" DEST="$dest" PORT="$port" KEY="$key" JUMP="$jump" \
        python3 <<'PYADD'
import json, os
path = os.environ["HOSTS"]
try:
    hosts = json.load(open(path))
except Exception:
    hosts = {}
dest = os.environ["DEST"]
user, _, host = dest.rpartition("@")
entry = {"host": host}
if user: entry["user"] = user
for env, key in (("PORT", "port"), ("KEY", "key"), ("JUMP", "jump")):
    if os.environ.get(env): entry[key] = os.environ[env]
hosts[os.environ["NAME"]] = entry
with open(path, "w") as fh:
    json.dump(hosts, fh, indent=2, sort_keys=True); fh.write("\n")
os.chmod(path, 0o600)
print(f"  added {os.environ['NAME']} -> {dest}")
PYADD
      info "check it:  myai terminal test $name"
      ;;
    remove|rm)
      local name="${1:-}"
      [ -z "$name" ] && { bad "usage: myai terminal remove <name>"; return 1; }
      HOSTS="$TERMINAL_HOSTS" NAME="$name" python3 <<'PYRM'
import json, os
path = os.environ["HOSTS"]
try:
    hosts = json.load(open(path))
except Exception:
    hosts = {}
if hosts.pop(os.environ["NAME"], None) is None:
    print(f"  no such target: {os.environ['NAME']}"); raise SystemExit(1)
with open(path, "w") as fh:
    json.dump(hosts, fh, indent=2, sort_keys=True); fh.write("\n")
print(f"  removed {os.environ['NAME']}")
PYRM
      ;;
    test)
      local name="${1:-}"
      [ -z "$name" ] && { bad "usage: myai terminal test <name>"; return 1; }
      local args
      args=$(HOSTS="$TERMINAL_HOSTS" NAME="$name" python3 <<'PYARGS'
import json, os, shlex
try:
    hosts = json.load(open(os.environ["HOSTS"]))
except Exception:
    hosts = {}
h = hosts.get(os.environ["NAME"])
if not isinstance(h, dict) or not h.get("host"):
    raise SystemExit(1)
argv = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
if h.get("port"): argv += ["-p", str(h["port"])]
if h.get("key"):  argv += ["-i", os.path.expanduser(h["key"])]
if h.get("jump"): argv += ["-J", h["jump"]]
argv.append(f"{h['user']}@{h['host']}" if h.get("user") else h["host"])
print(" ".join(shlex.quote(a) for a in argv))
PYARGS
      ) || { bad "no such target: $name"; return 1; }
      info "ssh $args uname -sm"
      # Runs as you, with your agent — not through the server.
      if eval "ssh $args uname -sm" 2>&1 | sed 's/^/      /'; then ok "$name reachable"
      else bad "$name unreachable — check the key is in ssh-agent and the jump host is right"; fi
      ;;
    *)
      bad "unknown subcommand: $sub"; info "myai terminal [list|add|remove|test]"; return 1 ;;
  esac
}


# ------------------------------------------------------------------ stats ---
# ollama logs per-request timings; this turns them into something readable.
OLLAMA_LOG="${OLLAMA_LOG:-/opt/homebrew/var/log/ollama.log}"
[ "$OS" = linux ] && OLLAMA_LOG="${OLLAMA_LOG:-$HOME/.ollama/logs/server.log}"

cmd_stats() {
  local n="${1:-12}"
  [ -r "$OLLAMA_LOG" ] || { bad "cannot read $OLLAMA_LOG"; return 1; }
  printf '%sRecent generations%s  %s(%s)%s\n' "$BOLD" "$OFF" "$DIM" "$OLLAMA_LOG" "$OFF"
  LOG="$OLLAMA_LOG" N="$n" python3 <<'PYSTATS'
import os, re, pathlib
text = pathlib.Path(os.environ["LOG"]).read_bytes().decode("utf-8", "replace")
P = re.compile(r'task (\d+) \| prompt eval time =\s*([\d.]+) ms /\s*(\d+) tokens')
E = re.compile(r'task (\d+) \|\s+eval time =\s*([\d.]+) ms /\s*(\d+) tokens.*?([\d.]+) tokens per second')
prompt = {t: (float(ms), int(n)) for t, ms, n in P.findall(text)}
evals  = {t: (float(ms), int(n), float(tps)) for t, ms, n, tps in E.findall(text)}
tasks  = sorted(evals, key=int)[-int(os.environ["N"]):]
if not tasks:
    print("    no completed generations logged yet"); raise SystemExit
print(f"    {'in':>7} {'out':>6} {'wait':>7} {'generate':>9} {'tok/s':>7}")
rows, rates = [], []
for t in tasks:
    p_ms, p_n = prompt.get(t, (0.0, 0))
    e_ms, e_n, tps = evals[t]
    rows.append((p_n, tps)); rates.append(tps)
    print(f"    {p_n:>7} {e_n:>6} {p_ms/1000:>6.1f}s {e_ms/1000:>8.1f}s {tps:>7.1f}")
mid = sorted(rates)[len(rates)//2]
print(f"\n    min {min(rates):.1f} · median {mid:.1f} · max {max(rates):.1f} tok/s   (n={len(rates)})")

# Generation slows as context grows — every token attends over everything before
# it — so a slow run on a long prompt is expected, not a fault. Only a slow run
# on a SHORT prompt points at a reload or two models competing for the GPU.
peak = max(rates)
short = [(n, r) for n, r in rows if n < 200]
suspect = [r for n, r in short if r < peak * 0.5]
big = [n for n, _ in rows if n >= 2000]
if suspect:
    print(f"    {len(suspect)} short-prompt run(s) under half peak — suspect a model reload")
    print(f"    or two models competing for GPU memory; check 'loaded now' below.")
elif big:
    print(f"    slower runs here are the long-context ones (up to {max(big)} prompt tokens),")
    print(f"    which is expected: generation cost grows with what is already in the window.")
PYSTATS
  printf '\n  %sloaded now%s\n' "$DIM" "$OFF"
  ollama ps 2>/dev/null | sed 's/^/    /'
}

case "${1:-}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_stop; echo; cmd_start ;;
  status)  cmd_status ;;
  logs)    cmd_logs "${2:-}" ;;
  backup)  cmd_backup "${2:-}" ;;
  terminal) shift; cmd_terminal "$@" ;;
  stats)   cmd_stats "${2:-}" ;;
  *)
    cat <<EOF
${BOLD}myai${OFF} — local AI stack (Ollama + ComfyUI + Kokoro + Open WebUI)

  myai start        start everything and open the browser
  myai stop         stop everything (persists across reboots)
  myai restart      stop then start
  myai status       show what is running
  myai logs         tail Open WebUI logs
  myai logs comfy   tail ComfyUI logs
  myai logs kokoro  tail Kokoro logs
  myai logs tts     tail TTS router logs
  myai logs jupyter tail Jupyter (code interpreter) logs
  myai logs mcpo    tail MCP tool server logs
  myai logs terminal tail terminal server logs
  myai backup [dir] back up chats/users/config (default ~/myai-backups)
  myai stats [N]    timings for the last N generations (default 12)

  myai terminal list                     show terminal targets
  myai terminal add <name> <[user@]host> [--port N] [--key PATH] [--jump host]
  myai terminal remove <name>
  myai terminal test <name>              check it is reachable over ssh


platform: $OS
EOF
    [ -n "${1:-}" ] && exit 1 || exit 0 ;;
esac
